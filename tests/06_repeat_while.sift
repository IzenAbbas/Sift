-- repeat while: sum of 1..10, and a loop that never runs.
process main gives val
begin
  declare i: val = 1;
  declare sum: val = 0;
  repeat while i <= 10
  begin
    set sum = sum + i;
    set i = i + 1;
  end
  show sum;
  show i;
  repeat while no
  begin
    show 999;
  end
  -- Collatz steps for 27
  declare n: val = 27;
  declare steps: val = 0;
  repeat while n != 1
  begin
    check n % 2 = 0
    begin
      set n = n / 2;
    end
    otherwise
    begin
      set n = 3 * n + 1;
    end
    set steps = steps + 1;
  end
  show steps;
  give back 0;
end
